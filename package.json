{
  "name": "polywall",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.15",
      "fast-uri": "^3.1.9",
      "fast-xml-builder": "^1.1.7",
      "hono": "^4.13.11",
      "postcss": "^8.5.23",
      "vite": "^7.3.7",
      "brace-expansion@>=1 <2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=3 <6": "^5.0.12"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yaml up --build",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yaml down --volumes --remove-orphans --rmi local",
    "docker:prod": "docker compose -f docker-compose.yaml up --build",
    "db:seed": "docker compose -f docker-compose.dev.yaml run --rm --build media-worker pnpm db:seed:worker",
    "db:seed:worker": "prisma migrate deploy && prisma db seed",
    "db:seed:direct": "prisma db seed",
    "db:studio": "prisma studio",
    "worker:media": "tsx src/workers/media-processing-worker.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@base-ui/react": "^1.9.0",
    "@casl/ability": "^7.0.2",
    "@casl/prisma": "^2.0.2",
    "@casl/react": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@meteocons/svg": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-shadcn": "^4.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "execa": "^9.6.1",
    "fflate": "^0.8.3",
    "file-type": "22.0.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "input-otp": "^1.5.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.2.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.91.0",
    "rss-parser": "^3.13.0",
    "sanitize-filename": "^1.6.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
