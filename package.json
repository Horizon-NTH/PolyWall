{
  "name": "polywall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.13",
      "postcss": "^8.5.10"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yaml up --build",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yaml down --volumes --remove-orphans --rmi local",
    "docker:prod": "docker compose -f docker-compose.yaml up --build",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "worker:media": "tsx src/workers/media-processing-worker.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
