    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "mime-types": "^3.0.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
