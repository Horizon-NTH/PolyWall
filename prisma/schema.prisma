generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  ORGANIZATION_ADMIN
  CONTENT_MANAGER
}

enum ScheduleType {
  DEFAULT
  RECURRING
  EVENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ZoneType {
  PLAYLIST
  WIDGET
  STATIC
  OVERLAY
}

enum MediaFileStatus {
  AWAITING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum MediaFileVariant {
  ORIGINAL
  THUMB
  RENDER
}

model Organization {
  id          String @id @default(cuid())
  name        String
  description String

  users            User[]
  mediaItems       MediaItem[]
  playlists        Playlist[]
  channels         Channel[]
  screens          Screen[]
  displayTemplates DisplayTemplate[]
  widgetInstances  WidgetInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  description  String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([role])
}

model Playlist {
  id          String @id @default(cuid())
  name        String
  description String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  items     PlaylistItem[]
  schedules PlaylistSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PlaylistItem {
  id         String @id @default(cuid())
  orderIndex Int

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String

  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaItemId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playlistId, orderIndex])
  @@index([mediaItemId])
}

model MediaItem {
  id              String  @id @default(cuid())
  title           String
  description     String
  durationSeconds Int
  active          Boolean @default(true)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  playlistItems PlaylistItem[]
  files         MediaFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([organizationId, createdAt])
}

model MediaFile {
  id               String  @id @default(cuid())
  storageBucket    String
  objectKey        String
  originalFileName String
  status           MediaFileStatus      @default(AWAITING_UPLOAD)
  variant          MediaFileVariant     @default(ORIGINAL)
  variantIndex     Int                  @default(0)
  sourceMediaFileId String?
  mimeType         String
  fileSizeBytes    BigInt
  metaJson         Json?

  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaItemId String
  sourceFile  MediaFile? @relation("MediaFileDerivatives", fields: [sourceMediaFileId], references: [id], onDelete: Cascade)
  derivedFiles MediaFile[] @relation("MediaFileDerivatives")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storageBucket, objectKey])
  @@unique([sourceMediaFileId, variant, variantIndex])
  @@index([mediaItemId])
  @@index([sourceMediaFileId, variant])
}

model DisplayTemplate {
  id          String @id @default(cuid())
  name        String
  description String
  templateKey String
  resolutionX Int
  resolutionY Int

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?

  channels Channel[]
  zones    DisplayZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateKey])
  @@index([organizationId])
}

model DisplayZone {
  id         String   @id @default(cuid())
  name       String
  slotName   String
  zoneType   ZoneType
  orderIndex Int
  positionX  Int
  positionY  Int
  width      Int
  height     Int

  template   DisplayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  widgetInstances WidgetInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, slotName])
  @@unique([templateId, orderIndex])
  @@index([templateId])
}

model Channel {
  id          String @id @default(cuid())
  name        String
  description String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  displayTemplate   DisplayTemplate @relation(fields: [displayTemplateId], references: [id], onDelete: Restrict)
  displayTemplateId String

  screens   Screen[]
  schedules PlaylistSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([displayTemplateId])
}

model Screen {
  id                       String  @id @default(cuid())
  name                     String
  location                 String
  interactive              Boolean @default(false)
  interruptionEnabled      Boolean @default(false)
  interactiveUrl           String?
  inactivityTimeoutSeconds Int?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  channelId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([channelId])
}

model WidgetType {
  id           String @id @default(cuid())
  name         String
  description  String
  technicalKey String @unique

  instances WidgetInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WidgetInstance {
  id                   String  @id @default(cuid())
  configurationJson    Json
  active               Boolean @default(true)
  refreshPeriodSeconds Int

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  widgetType   WidgetType @relation(fields: [widgetTypeId], references: [id], onDelete: Restrict)
  widgetTypeId String

  displayZone   DisplayZone @relation(fields: [displayZoneId], references: [id], onDelete: Cascade)
  displayZoneId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([widgetTypeId])
  @@index([displayZoneId])
}

model PlaylistSchedule {
  id        String       @id @default(cuid())
  startDate DateTime?    @db.Date
  endDate   DateTime?    @db.Date
  type      ScheduleType
  active    Boolean      @default(true)

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  timeSlots ScheduleTimeSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playlistId])
  @@index([channelId])
  @@index([type, active])
}

model ScheduleTimeSlot {
  id        String    @id @default(cuid())
  startTime DateTime  @db.Time
  endTime   DateTime  @db.Time
  dayOfWeek DayOfWeek

  schedule   PlaylistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, dayOfWeek, startTime, endTime])
  @@index([scheduleId])
}
